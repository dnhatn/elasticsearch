        \_TimeSeriesAggregate[[_tsid{m}#6, BUCKET{r}#2],[RATE(network.total_bytes_in{f}#7,@timestamp{f}#8,true[BOOLEAN],PT0S[TIME_DURATION]) AS RATE_$1#5, PACKDIMSAGG(cluster{f}#1,true[BOOLEAN],PT0S[TIME_DURATION]) AS _$packed_dims#4, BUCKET{r}#2],BUCKET(@timestamp{f}#8,PT1H[TIME_DURATION]),@timestamp{f}#8,TS_COMMAND]
          \_Eval[[BUCKET(@timestamp{f}#8,PT1H[TIME_DURATION]) AS BUCKET#2]]
